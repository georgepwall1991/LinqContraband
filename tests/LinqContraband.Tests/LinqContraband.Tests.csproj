<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <LangVersion>latestmajor</LangVersion>
        <NoWarn>$(NoWarn);CS0618</NoWarn>
        <!-- The inline test sources exceed the 16 MB #US metadata heap (CS8103). Emit long
             string literals into a data section instead of the user-string heap. -->
        <Features>$(Features);experimental-data-section-string-literals=100</Features>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector" Version="10.0.1"/>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing.XUnit" Version="1.1.2"/>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.CodeFix.Testing.XUnit" Version="1.1.2"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0"/>

        <!-- The analyzer compiles against the Roslyn 4.3 API surface for broad consumer
             compatibility, but the tests host it on a current Roslyn so test sources can use
             the language version real net10 consumers compile with. Pinning the harness to
             4.3 capped test code at C# 11 and hid defects that only appear on newer
             language versions. -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.14.0" />
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.3.0" />

        <PackageReference Include="xunit" Version="2.4.2"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\LinqContraband\LinqContraband.csproj"/>
    </ItemGroup>

    <!-- Real EF Core metadata for CrossProjectAnalysisTests, which compile a data library and an app
         that references it (as an IDE workspace does). The assemblies are downloaded, not referenced,
         and copied to efcore/ so they stay out of the test host's trusted platform assemblies: the
         verifier tests reference every trusted assembly next to their own EF mocks. -->
    <ItemGroup>
        <EfCoreTestReference Include="Microsoft.EntityFrameworkCore" Version="8.0.31" />
        <EfCoreTestReference Include="Microsoft.EntityFrameworkCore.Abstractions" Version="8.0.31" />
        <EfCoreTestReference Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.31" />
        <EfCoreTestReference Include="Microsoft.Extensions.Caching.Abstractions" Version="8.0.0" />
        <EfCoreTestReference Include="Microsoft.Extensions.Caching.Memory" Version="8.0.1" />
        <EfCoreTestReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
        <EfCoreTestReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
        <EfCoreTestReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
        <EfCoreTestReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
        <EfCoreTestReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
        <EfCoreTestReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
        <EfCoreTestReference Include="Microsoft.Extensions.Primitives" Version="8.0.0" />
        <PackageDownload Include="Microsoft.EntityFrameworkCore" Version="[8.0.31]" />
        <PackageDownload Include="Microsoft.EntityFrameworkCore.Abstractions" Version="[8.0.31]" />
        <PackageDownload Include="Microsoft.EntityFrameworkCore.Relational" Version="[8.0.31]" />
        <PackageDownload Include="Microsoft.Extensions.Caching.Abstractions" Version="[8.0.0]" />
        <PackageDownload Include="Microsoft.Extensions.Caching.Memory" Version="[8.0.1]" />
        <PackageDownload Include="Microsoft.Extensions.Configuration.Abstractions" Version="[8.0.0]" />
        <PackageDownload Include="Microsoft.Extensions.DependencyInjection" Version="[8.0.1]" />
        <PackageDownload Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="[8.0.2]" />
        <PackageDownload Include="Microsoft.Extensions.Logging" Version="[8.0.1]" />
        <PackageDownload Include="Microsoft.Extensions.Logging.Abstractions" Version="[8.0.2]" />
        <PackageDownload Include="Microsoft.Extensions.Options" Version="[8.0.2]" />
        <PackageDownload Include="Microsoft.Extensions.Primitives" Version="[8.0.0]" />
    </ItemGroup>

    <Target Name="CopyEfCoreTestReferences" AfterTargets="Build">
        <ItemGroup>
            <_EfCoreTestReferenceFile Include="$(NuGetPackageRoot)$([System.String]::Copy('%(EfCoreTestReference.Identity)').ToLowerInvariant())/%(EfCoreTestReference.Version)/lib/net8.0/*.dll" />
        </ItemGroup>
        <Copy SourceFiles="@(_EfCoreTestReferenceFile)" DestinationFolder="$(OutDir)efcore" SkipUnchangedFiles="true" />
    </Target>

</Project>
